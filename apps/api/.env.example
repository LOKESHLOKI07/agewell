DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agewell
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=supersecretjwtkeythatshouldbechanged
JWT_REFRESH_SECRET=supersecretrefreshkey
ENVIRONMENT=development
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=EldCare <noreply@example.com>
# Optional Meta WhatsApp Cloud API for phone OTPs (login + family invite).
# Leave empty for demo mode (code logged / returned as debug_code).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v21.0
WHATSAPP_DEFAULT_COUNTRY_CODE=91
GOOGLE_CLIENT_ID=
# Optional. Only needed for browser/code Google login, not the Android APK.
GOOGLE_CLIENT_SECRET=
# Optional Care Concierge. Leave empty to use built-in keyword intents for demos.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
