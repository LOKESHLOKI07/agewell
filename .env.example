# Public API base URL for the FastAPI backend.
# Do not include a trailing slash.
#
# Choose the value that matches how you run the mobile app:
#   iOS simulator:     http://localhost:8000
#   Android emulator:  http://10.0.2.2:8000
#   Physical device:   http://YOUR_LAN_IP:8000
#
# Example (iOS simulator / web):
# EXPO_PUBLIC_API_URL=http://localhost:8000
#
# APK / production (VPS):
# EXPO_PUBLIC_API_URL=https://mountainexplorers.ind.in:8443

# Google Maps (react-native-maps). Do not commit real keys.
# Create a Google Cloud project, enable Maps SDK for Android and Maps SDK for iOS,
# then restrict each key (Android: package in.agewell.family + SHA-1; iOS: bundle in.agewell.family).
# Keys are read at native prebuild time. Rebuild after changing them.
# Expo Go can show a map without these keys; store binaries and Google Maps on iOS need them.
ANDROID_GOOGLE_MAPS_API_KEY=
IOS_GOOGLE_MAPS_API_KEY=
